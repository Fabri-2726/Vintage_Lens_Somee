@model Producto
@{
    bool esNuevo = (ViewBag.EsNuevo as bool?) == true;
    ViewData["Title"] = esNuevo ? "Agregar producto" : "Editar producto";
    string accion = esNuevo ? "Crear" : "Editar";
    var categorias = ViewBag.Categorias as List<Categoria> ?? new List<Categoria>();
}
<h1 class="fw-bold mb-3">@ViewData["Title"]</h1>
<partial name="_AdminNav" />

@if (ViewBag.Error != null)
{
    <div class="alert alert-danger">@ViewBag.Error</div>
}

<form asp-action="@accion" asp-route-id="@Model.Id" method="post" enctype="multipart/form-data" class="bg-white shadow-sm p-4" style="max-width: 760px;">
    <div class="mb-3">
        <label class="form-label fw-bold">Nombre</label>
        <input type="text" name="nombre" value="@Model.Nombre" maxlength="255" class="form-control" required />
    </div>
    <div class="mb-3">
        <label class="form-label fw-bold">Descripción</label>
        <textarea name="descripcion" rows="4" class="form-control">@Model.Descripcion</textarea>
    </div>
    <div class="row">
        <div class="col-md-4 mb-3">
            <label class="form-label fw-bold">Precio (MXN)</label>
            <input type="number" step="0.01" min="0" name="precio" value="@Model.Precio.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)" class="form-control" required />
        </div>
        <div class="col-md-4 mb-3">
            <label class="form-label fw-bold">Stock</label>
            <input type="number" min="0" name="stock" value="@Model.Stock" class="form-control" required />
        </div>
        <div class="col-md-4 mb-3">
            <label class="form-label fw-bold">Categoría</label>
            <select name="categoriaId" class="form-select" required>
                @foreach (var c in categorias)
                {
                    <option value="@c.Id" selected="@(c.Id == Model.CategoriaId)">@c.Nombre</option>
                }
            </select>
        </div>
    </div>
    <div class="mb-3">
        <label class="form-label fw-bold">Imagen actual / URL de imagen</label>
        <input type="text" name="imagenUrl" value="@Model.ImagenUrl" class="form-control" placeholder="/images/MI_PRODUCTO.jpg" />
        @if (!string.IsNullOrEmpty(Model.ImagenUrl))
        {
            <img src="@Model.ImagenUrl" alt="" class="mt-2" style="height:90px;object-fit:contain;" onerror="this.style.visibility='hidden'" />
        }
    </div>
    <div class="mb-4">
        <label class="form-label fw-bold">O sube una imagen nueva (JPG, PNG, WEBP; máx. 5 MB)</label>
        <input type="file" name="imagen" accept=".jpg,.jpeg,.png,.webp,.gif" class="form-control" />
    </div>
    <button type="submit" class="btn admin-btn px-4 py-2">Guardar</button>
    <a asp-action="Productos" class="btn btn-outline-dark rounded-0 px-4 py-2 ms-2">Cancelar</a>
</form>
