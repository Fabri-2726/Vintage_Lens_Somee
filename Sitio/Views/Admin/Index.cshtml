@{
    ViewData["Title"] = "Panel de Administración";
    decimal ventas = (decimal)ViewBag.Ventas;
}
<h1 class="fw-bold mb-3">Panel de Administración</h1>
<partial name="_AdminNav" />

<div class="row g-4 mb-4">
    <div class="col-md-3"><div class="card border-0 shadow-sm p-3 text-center"><div class="text-muted small">PRODUCTOS</div><div class="fs-2 fw-bold">@ViewBag.TotalProductos</div></div></div>
    <div class="col-md-3"><div class="card border-0 shadow-sm p-3 text-center"><div class="text-muted small">SIN STOCK</div><div class="fs-2 fw-bold text-danger">@ViewBag.SinStock</div></div></div>
    <div class="col-md-3"><div class="card border-0 shadow-sm p-3 text-center"><div class="text-muted small">PEDIDOS</div><div class="fs-2 fw-bold">@ViewBag.TotalPedidos</div></div></div>
    <div class="col-md-3"><div class="card border-0 shadow-sm p-3 text-center"><div class="text-muted small">USUARIOS</div><div class="fs-2 fw-bold">@ViewBag.TotalUsuarios</div></div></div>
</div>
<div class="card border-0 shadow-sm p-4 mb-4">
    <div class="text-muted small">VENTAS TOTALES REGISTRADAS</div>
    <div class="fs-1 fw-bold" style="color: var(--accent-gold);">$@ventas.ToString("N2") MXN</div>
</div>
<div class="d-flex gap-2">
    <a asp-action="Crear" class="btn admin-btn px-4 py-2"><i class="fas fa-plus me-1"></i> Agregar producto</a>
    <a asp-action="Productos" class="btn btn-outline-dark rounded-0 px-4 py-2 fw-bold">Consultar / modificar precios</a>
    <a asp-action="Pedidos" class="btn btn-outline-dark rounded-0 px-4 py-2 fw-bold">Ver pedidos</a>
</div>
