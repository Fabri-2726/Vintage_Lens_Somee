@model List<Producto>
@{
    ViewData["Title"] = "Administrar productos";
    string q = ViewBag.Q as string ?? "";
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="fw-bold m-0">Productos</h1>
    <a asp-action="Crear" class="btn admin-btn px-4 py-2"><i class="fas fa-plus me-1"></i> Agregar producto</a>
</div>
<partial name="_AdminNav" />

<form method="get" asp-action="Productos" class="mb-3 d-flex gap-2" style="max-width: 480px;">
    <input type="text" name="q" value="@q" class="form-control" placeholder="Buscar por nombre o categoría..." />
    <button class="btn admin-btn px-3" type="submit"><i class="fas fa-search"></i></button>
</form>

<div class="table-responsive bg-white shadow-sm">
    <table class="table align-middle mb-0">
        <thead class="table-dark">
            <tr><th>#</th><th></th><th>Producto</th><th>Categoría</th><th>Precio (MXN) y stock</th><th class="text-end">Acciones</th></tr>
        </thead>
        <tbody>
        @foreach (var p in Model)
        {
            <tr>
                <td>@p.Id</td>
                <td><img src="@p.ImagenUrl" alt="" style="width:50px;height:50px;object-fit:contain;" onerror="this.style.visibility='hidden'" /></td>
                <td class="fw-bold">@p.Nombre</td>
                <td class="text-muted">@p.Categoria?.Nombre</td>
                <td>
                    <form asp-action="ActualizarRapido" method="post" class="d-flex gap-2 align-items-center">
                        <input type="hidden" name="id" value="@p.Id" />
                        <div class="input-group input-group-sm" style="width:160px;">
                            <span class="input-group-text">$</span>
                            <input type="number" step="0.01" min="0" name="precio" value="@p.Precio.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)" class="form-control" />
                        </div>
                        <input type="number" min="0" name="stock" value="@p.Stock" class="form-control form-control-sm" style="width:80px;" title="Stock" />
                        <button class="btn btn-sm admin-btn" type="submit">Guardar</button>
                    </form>
                </td>
                <td class="text-end">
                    <a asp-action="Editar" asp-route-id="@p.Id" class="btn btn-sm btn-outline-dark rounded-0"><i class="fas fa-pen"></i></a>
                    <form asp-action="Eliminar" asp-route-id="@p.Id" method="post" class="d-inline" onsubmit="return confirm('¿Eliminar este producto?');">
                        <button class="btn btn-sm btn-outline-danger rounded-0" type="submit"><i class="fas fa-trash"></i></button>
                    </form>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>
<p class="text-muted small mt-2">@Model.Count producto(s)</p>
