@model Pedido
@{
    ViewData["Title"] = "Pedido " + Model.Folio;
}
<h1 class="fw-bold mb-3">Pedido @Model.Folio</h1>
<partial name="_AdminNav" />

<div class="row g-4">
    <div class="col-md-5">
        <div class="card border-0 shadow-sm p-4">
            <p class="mb-1"><strong>Cliente:</strong> @Model.Usuario?.Nombre</p>
            <p class="mb-1"><strong>Correo:</strong> @Model.Usuario?.Email</p>
            <p class="mb-1"><strong>Fecha:</strong> @(Model.Fecha.HasValue ? Model.Fecha.Value.ToString("dd/MM/yyyy HH:mm") : "-")</p>
            <p class="mb-1"><strong>Método de pago:</strong> @Model.MetodoPago</p>
            <p class="mb-1"><strong>Estado:</strong> @Model.EstadoPago</p>
            <p class="mb-0"><strong>Dirección de envío:</strong> @(string.IsNullOrWhiteSpace(Model.DireccionEnvio) ? "-" : Model.DireccionEnvio)</p>
        </div>
    </div>
    <div class="col-md-7">
        <div class="table-responsive bg-white shadow-sm">
            <table class="table align-middle mb-0">
                <thead class="table-dark"><tr><th>Producto</th><th class="text-center">Cant.</th><th class="text-end">Precio</th><th class="text-end">Subtotal</th></tr></thead>
                <tbody>
                @foreach (var d in Model.DetallePedidos)
                {
                    <tr>
                        <td>@d.Producto?.Nombre</td>
                        <td class="text-center">@d.Cantidad</td>
                        <td class="text-end">$@d.PrecioUnitario.ToString("N2")</td>
                        <td class="text-end">$@((d.Cantidad * d.PrecioUnitario).ToString("N2"))</td>
                    </tr>
                }
                </tbody>
                <tfoot><tr><th colspan="3" class="text-end">TOTAL</th><th class="text-end">$@Model.Total.ToString("N2")</th></tr></tfoot>
            </table>
        </div>
    </div>
</div>
<a asp-action="Pedidos" class="btn btn-outline-dark rounded-0 mt-3">« Volver a pedidos</a>
