@{
    string actual = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
}
<style>
    .admin-btn { background-color: var(--dark-desaturated); color: #fff; border: 1px solid var(--dark-desaturated); border-radius: 0; font-weight: bold; }
    .admin-btn:hover { background-color: var(--accent-gold); border-color: var(--accent-gold); color: #fff; }
</style>
<div class="d-flex flex-wrap gap-2 mb-4">
    <a asp-action="Index" class="btn btn-sm @(actual == "Index" ? "admin-btn" : "btn-outline-dark rounded-0")"><i class="fas fa-chart-line me-1"></i> Resumen</a>
    <a asp-action="Productos" class="btn btn-sm @(actual == "Productos" || actual == "Crear" || actual == "Editar" ? "admin-btn" : "btn-outline-dark rounded-0")"><i class="fas fa-camera me-1"></i> Productos</a>
    <a asp-action="Pedidos" class="btn btn-sm @(actual == "Pedidos" || actual == "PedidoDetalle" ? "admin-btn" : "btn-outline-dark rounded-0")"><i class="fas fa-receipt me-1"></i> Pedidos</a>
</div>
@if (TempData["Exito"] != null)
{
    <div class="alert alert-success">@TempData["Exito"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}
