@{ ViewData["Title"] = "Verificación 2 Pasos"; }
<div class="row justify-content-center mt-5 mb-5 min-vh-100">
    <div class="col-md-4 text-center">
        <div class="card shadow-sm border-0 p-4">
            <i class="fab fa-telegram-plane fa-3x mb-3" style="color: #0088cc;"></i>
            <h4 class="fw-bold mb-3">Verificación Requerida</h4>
            <p class="text-muted small mb-4">Hemos enviado un código de 6 dígitos a tu cuenta de Telegram.</p>
            
            @if(ViewBag.Error != null) { <div class="alert alert-danger small">@ViewBag.Error</div> }
            
            <form asp-action="Verificar2FA" method="post">
                <input type="text" name="codigo" class="form-control form-control-lg text-center fw-bold mb-4 rounded-0" placeholder="000000" maxlength="6" autocomplete="off" required>
                <button type="submit" class="btn btn-vintage w-100 fw-bold rounded-0">VERIFICAR CÓDIGO</button>
            </form>
        </div>
    </div>
</div>